rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'QJjEVBmFJBadwqXKGn4ITtxJlXi1';
    }

    // ---------------------------------------------------------------
    // Products
    // Public can read only active products. Admin can read/write all.
    // ---------------------------------------------------------------
    match /products/{productId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Site settings
    // Public can read. Only admin can write.
    // ---------------------------------------------------------------
    match /siteSettings/{settingsId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Orders
    // Anyone can CREATE an order if it passes basic validation.
    // Nobody but admin can read. Only admin can update, and only the
    // status field. Nobody can delete an order, ever.
    // ---------------------------------------------------------------
    match /orders/{orderId} {
      allow create: if
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() > 0 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() > 0 &&
        request.resource.data.city is string &&
        request.resource.data.city.size() > 0 &&
        request.resource.data.address is string &&
        request.resource.data.address.size() > 0 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.subtotal is number &&
        request.resource.data.total is number &&
        request.resource.data.status == 'pending';

      allow read: if isAdmin();

      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        (request.resource.data.status == 'pending' ||
         request.resource.data.status == 'completed' ||
         request.resource.data.status == 'rejected');

      allow delete: if false;
    }
  }
}
